# Momentum Terminal — environment variables
# Copy to .env.local for local development. Never commit real values.
# Find the Supabase values under Project Settings → API Keys in the dashboard.

# ---------------------------------------------------------------------------
# Supabase (Phase 1)
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_...). Safe for the browser; every query made
# with it is subject to Row Level Security. The legacy "anon" JWT also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (sb_secret_...) or the legacy "service_role" JWT. SERVER ONLY.
# Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Public base URL of this app. Used to build auth redirect links (email
# confirmation, password reset). Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Data ingestion (Phase 2) — all SERVER ONLY
# ---------------------------------------------------------------------------

# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials,
# with "YouTube Data API v3" enabled). Used by lib/connectors/youtube.ts.
YOUTUBE_API_KEY=

# Random string that authorises calls to /api/ingest. Callers send it as
# `x-ingest-secret: <value>` or `Authorization: Bearer <value>`.
# Generate one with: openssl rand -hex 32
INGEST_SECRET=

# ---------------------------------------------------------------------------
# The Engine (Phase 3) — SERVER ONLY
# ---------------------------------------------------------------------------

# Random string that authorises calls to /api/engine/tick. Callers send it as
# `x-engine-secret: <value>` or `Authorization: Bearer <value>`.
# Generate one with: openssl rand -hex 32
ENGINE_SECRET=

# Optional: which SentimentScorer the Engine uses. "rules" (default) is the
# keyword scorer; Phase 4 registers an LLM scorer.
# SENTIMENT_SCORER=rules

# ---------------------------------------------------------------------------
# Reserved for later phases (do not set until the connector is activated)
# ---------------------------------------------------------------------------
# TWITCH_CLIENT_ID=          # twitch connector (Helix, client-credentials flow)
# TWITCH_CLIENT_SECRET=      # twitch connector
# SPOTIFY_CLIENT_ID=         # spotify connector (Web API, client-credentials flow)
# SPOTIFY_CLIENT_SECRET=     # spotify connector
# FINNHUB_API_KEY=           # finnhub connector
# NEWSDATA_KEY=              # newsdata connector
# RAPIDAPI_KEY=              # forbes and billboard connectors (RapidAPI wrappers)
# APISPORTS_KEY=             # apisports connector
