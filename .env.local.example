# Momentum Terminal — environment variables
# Copy to .env.local for local development. Never commit real values.
# Find the Supabase values under Project Settings → API Keys in the dashboard.

# ---------------------------------------------------------------------------
# Supabase (Phase 1)
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_...). Safe for the browser; every query made
# with it is subject to Row Level Security. The legacy "anon" JWT also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (sb_secret_...) or the legacy "service_role" JWT. SERVER ONLY.
# Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# THE SITE'S PUBLIC ADDRESS, and the only place it is written. Auth redirect
# links (email confirmation, password reset), the landing page's canonical
# URL, its Open Graph image and every absolute link derive from this (Phase
# 28: lib/env.ts getSiteOrigin()/absoluteUrl()); a test fails the suite if a
# vercel.app hostname is ever written as a literal in app code. The Vercel
# URL today; moving to a custom domain is changing this one value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Data ingestion (Phase 2) — all SERVER ONLY
# ---------------------------------------------------------------------------

# Credentials come from the environment, never from the repo or the bundle. A
# connector whose credentials are unset reports itself unavailable: its source
# is inactive for the run (logged as a skipped poll) and the rest of the run
# proceeds without it.

# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials,
# with "YouTube Data API v3" enabled). Used by the youtube (channel metrics,
# commentary volume) and youtube_comments (viewer comments) connectors. The
# commentary read is search.list at 100 quota units per poll; the default
# 10,000-unit daily quota covers hourly polling of a few channels.
YOUTUBE_API_KEY=

# Spotify Web API client credentials (developer.spotify.com → an app). Public
# artist data only, no user login. Used by the spotify connector.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Finnhub API key (finnhub.io → a free account). The executives' companies, for
# the COUNT of news about them and the tracked person's own Form 4 filings. The
# free tier's 60 calls a minute is far above what nine companies need.
# NO PRICE FROM THIS KEY CONTRIBUTES TO ANY SCORE: the daily close is recorded
# as an observe-only snapshot (data_sources.config.observe_only) and reaches no
# observation, signal or force. Unset, the source reports itself unavailable and
# the run carries on without it.
FINNHUB_API_KEY=

# Random string that authorises calls to /api/ingest and /api/admin/health.
# Callers send it as `x-ingest-secret: <value>` or `Authorization: Bearer <value>`.
# Generate one with: openssl rand -hex 32
# A manual run: curl -X POST -H "x-ingest-secret: $INGEST_SECRET" "https://<host>/api/ingest?force=1"
INGEST_SECRET=

# ---------------------------------------------------------------------------
# The Engine (Phase 3) — SERVER ONLY
# ---------------------------------------------------------------------------

# Random string that authorises calls to /api/engine/tick. Callers send it as
# `x-engine-secret: <value>` or `Authorization: Bearer <value>`.
# Generate one with: openssl rand -hex 32
ENGINE_SECRET=

# Which SentimentScorer the Engine uses: "llm" (default) or "rules" for an
# instant fallback to the Phase 3 keyword scorer.
SCORER=llm

# Controlled-test override (optional). The Trading Activity force stays silent
# until at least this many one-minute windows in the trailing day saw a trade
# (the minimum-sample guard). The code default is 30 and does not change; a
# small beta group may never reach it, so it can be lowered DELIBERATELY here
# for the duration of the test. A positive integer; anything else is ignored.
# ENGINE_TRADING_MIN_POPULATED_WINDOWS=30

# The per-person volume weight's reference rate (Phase 18++). Every event
# signal's impact is multiplied by this divided by the person's own typical
# events a day, bounded to [0.1, 2]. The code default is 4: the GEOMETRIC MEAN
# of the roster's measured daily rates on 2026-09-18. Phase 15's 20 was chosen
# against an assumed roster and put fourteen of sixteen people on the ceiling,
# which made the weight a constant rather than a normalisation.
#
# This is the one tunable EXPECTED to go stale — it is a cross-person constant
# inside a per-person mechanism, so adding subjects or sources moves it. Watch
# /admin under "Signal volume" and re-derive when either more than a third of
# the engaged people sit on a bound, or the roster's live geometric mean leaves
# [reference / 2, reference x 2]. A positive number; decimals allowed; anything
# else leaves the default.
# ENGINE_VOLUME_REFERENCE=4

# Market Mood's trailing window, in minutes (Phase 19+; code default 60). The
# mood is the board's mean per-person Signals movement over the ticks inside
# this window that moved anyone, so it answers "how has the board moved
# recently" rather than "what landed in this thirty seconds". Shorter leaves
# the mood absent between the fifteen-minute ingestion bursts (30 minutes:
# absent on 16% of ticks); longer reads as the mood of the afternoon rather
# than of the hour. A positive number; anything else leaves the default.
#
# The profile's forces panel sums each force over the same 60 minutes
# (FORCES_WINDOW_MINUTES, a code constant, pinned to this default by a test).
# Overriding this here moves the mood's window and NOT the panel's, so the two
# would describe different spans; change the constant with it if you do.
# ENGINE_MOOD_WINDOW_MINUTES=60

# Market Mood's rate, in score points per hour per unit of mood (code default
# 1.41), applied as rate x the person's own elapsed hours, exactly as Gravity
# applies its lambda — so the force cannot be re-levelled by a change to the
# tick interval. DERIVED, not chosen: the old per-tick fraction of 0.25
# divided by the measured 21.27x rise in the force's firing that windowing
# produces, which holds the contribution where it was (0.0362 -> 0.0361 points
# an hour gross, replayed over the 48 hours to 2026-09-18). Re-derive it here
# when the burst cadence changes materially. A positive number; decimals
# allowed; anything else leaves the default.
# ENGINE_MOOD_RATE_PER_HOUR=1.41

# The drifting Gravity target (Phase 14). With this exactly "true", a
# person's target is their seeded revert_target plus an offset the Engine
# moves over weeks from sustained signal evidence (half-life 14 days, bounded
# ±8 points): months of positive coverage settle higher, an inert person
# sinks toward their own floor. Anything else leaves every target at its
# seed and accumulates nothing. Ships off; turn it on deliberately.
ENGINE_TARGET_DRIFT_ENABLED=false

# Autonomous ticking (the heartbeat). vercel.json schedules /api/engine/cron
# every minute; each invocation runs two ticks 30 s apart. ONLY the exact
# string "true" turns it on; leave it "false" until you want the Engine live.
# Flip it to "true" in the Vercel project env vars (Production) to enable.
ENGINE_CRON_ENABLED=false

# Autonomous ingestion, a separate switch: /api/ingest/cron every fifteen
# minutes (the sources on their own intervals) and, since Phase 16,
# /api/ingest/live every minute (who among the mapped broadcasters is on air,
# and a sample every few minutes for each one who is). Same rule: only the
# exact string "true" turns them on. Live mode is further gated per source by
# the data_sources row's config.live.enabled.
INGEST_CRON_ENABLED=false

# Vercel's cron secret. Set it in the Vercel project env vars; Vercel then
# sends `Authorization: Bearer <CRON_SECRET>` on every scheduled invocation
# and the handler rejects anything else (ENGINE_SECRET also works for manual
# calls). Generate one with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# LLM reasoning layer (Phase 4) — all SERVER ONLY
# ---------------------------------------------------------------------------

# Active provider: anthropic (default) | openai | gemini | openai-compatible.
# Swapping vendors is this one variable; nothing else changes.
LLM_PROVIDER=anthropic

# Model string for the active provider. Leave empty for the provider default
# (claude-opus-5 on Anthropic).
LLM_MODEL=claude-opus-5

# Anthropic Messages API key (console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional per-task routing: a cheap model for simple scoring, a premium one
# for anomaly reasoning. Unset = LLM_PROVIDER / LLM_MODEL. Task names:
# SENTIMENT, ANOMALY, NARRATIVE, MEMORY; each accepts LLM_PROVIDER_<TASK>,
# LLM_MODEL_<TASK> and LLM_EFFORT_<TASK> (low | medium | high).
# LLM_MODEL_SENTIMENT=claude-haiku-4-5-20251001
# LLM_MODEL_ANOMALY=claude-opus-5
# LLM_MODEL_NARRATIVE=
# LLM_MODEL_MEMORY=

# Reserved for other providers (only needed once their adapter is implemented):
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=   # e.g. https://api.groq.com/openai/v1 or https://api.together.xyz/v1
# OPENAI_COMPATIBLE_API_KEY=

# ---------------------------------------------------------------------------
# Reserved for later phases (do not set until the connector is activated)
# ---------------------------------------------------------------------------
# TWITCH_CLIENT_ID=          # twitch connector (Helix, client-credentials flow)
# TWITCH_CLIENT_SECRET=      # twitch connector
# NEWSDATA_KEY=              # newsdata connector
# RAPIDAPI_KEY=              # forbes and billboard connectors (RapidAPI wrappers)
# APISPORTS_KEY=             # apisports connector
